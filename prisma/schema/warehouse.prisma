model Warehouse {
  id        String          @id @default(uuid()) @db.Uuid
  name      String
  location  String
  metadata  Json?
  status    WarehouseStatus @default(OPEN)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  areas     StorageArea[]

  @@index([status, id])
  @@map("warehouses")
}

model StorageArea {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  type        StorageAreaType @default(GENERAL_STORAGE)
  warehouseId String          @db.Uuid
  status      WarehouseStatus @default(OPEN)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  slots       Slot[]
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([warehouseId, type])
  @@map("storage_areas")
}

model Slot {
  id         String      @id @default(uuid()) @db.Uuid
  areaId     String      @db.Uuid
  serial     String
  productId  String?     @db.Uuid
  ownerId    String?     @db.Uuid
  status     SlotStatus  @default(AVAILABLE)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orderSlots OrderSlot[]
  area       StorageArea @relation(fields: [areaId], references: [id], onDelete: Cascade)
  shop       Shop?       @relation(fields: [ownerId], references: [id])

  @@index([id, status])
  @@map("slots")
}

model OrderSlot {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @db.Uuid
  slotId    String   @db.Uuid
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  slot      Slot     @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([orderId, slotId])
  @@map("order_slots")
}

enum WarehouseStatus {
  OPEN
  CLOSED
  UNDER_MAINTENANCE
  FULL
}

enum StorageAreaType {
  COLD_STORAGE
  DRY_STORAGE
  HAZARDOUS_MATERIALS
  GENERAL_STORAGE
  ELECTRICAL_EQUIPMENT
}

enum SlotStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  DAMAGED
}
